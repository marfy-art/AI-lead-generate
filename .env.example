DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
NEXT_PUBLIC_SUPABASE_URL=
# Preferred key name for new Supabase projects
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still expose an anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=

# Discovery
GOOGLE_MAPS_API_KEY=
# Card-free, low-volume company lookup. Review the Nominatim usage policy before opting in.
ENABLE_NOMINATIM=false
# Identify your deployment; include a contact URL or email for production use.
NOMINATIM_USER_AGENT=SignalDesk/0.1 (+https://kriyakarak.com)
# Keep disabled until each source's terms and robots policy have been reviewed
ENABLE_PUBLIC_WEB_FETCH=false

# Enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
ZEROBOUNCE_API_KEY=

# Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Security (generate a 32-byte secret before using real contact data)
APP_ENCRYPTION_KEY=

# Keep true until provider credentials and compliance reviews are complete
MOCK_PROVIDERS=true
